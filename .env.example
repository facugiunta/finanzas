# Copiá este archivo a .env.local y completá los valores.
# NUNCA subas .env.local a git (está en .gitignore).

# ── Supabase (requerido) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO server-side. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic / Claude (requerido para el Asesor IA) ──
ANTHROPIC_API_KEY=

# ── Opcionales (features inactivas) ──
MP_ACCESS_TOKEN=
GMAIL_USER=
GMAIL_APP_PASSWORD=
CRON_SECRET=
